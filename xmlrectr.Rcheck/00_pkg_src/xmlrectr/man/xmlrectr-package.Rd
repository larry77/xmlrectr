\name{xmlrectr-package}
\alias{xmlrectr}
\alias{xmlrectr-package}
\docType{package}
\title{xmlrectr: generic XML rectangling}
\description{
Convert arbitrary XML into canonical node tables and analysis-friendly
rectangles with explicit profiles, bounded streaming, optional native
acceleration, and automatic record-level parallel execution.
}
\details{
The normal workflow is proposal, review, profile, compilation, and rectangling.
For exploratory work, the analyst layer provides a self-contained single-table
projection. See the package README and vignettes for complete workflows.
}
\seealso{
\code{propose_xml_profile()}, \code{xml_profile()}, \code{rectangle_xml()},
\code{rectangle_xml_analyst()}
}
\keyword{package}
